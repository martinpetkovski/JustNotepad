// JustNotepad installer resources. build.ps1 passes /i docs /i build so the
// icon and the freshly built JustNotepad.exe are found by name.
#include <windows.h>
#include <winver.h>
#include "resource.h"
#include "../win/version.h"

IDI_APP ICON "icon.ico"
1 24 "app.manifest"

// The program being installed, carried inside the installer.
IDR_APPEXE RCDATA "JustNotepad.exe"

IDD_SETUP DIALOGEX 0, 0, 290, 266
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "JustNotepad Setup"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_APP, IDC_SETUP_ICON, 14, 14, 21, 20
    LTEXT           "Install JustNotepad", IDC_TITLE, 45, 11, 235, 16
    LTEXT           "", IDC_INFO, 45, 31, 235, 20
    EDITTEXT        IDC_PATH, 45, 53, 180, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 230, 52, 50, 15
    LTEXT           "&Open these file types with JustNotepad:", IDC_TYPESLABEL, 45, 75, 235, 9
    CONTROL         "", IDC_TYPES, "SysListView32", LVS_LIST | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 45, 86, 235, 96
    PUSHBUTTON      "&All", IDC_ALL, 45, 185, 40, 14
    PUSHBUTTON      "&None", IDC_NONE, 89, 185, 40, 14
    AUTOCHECKBOX    "Add ""&Edit with JustNotepad"" to the right-click menu", IDC_CONTEXT, 45, 206, 235, 11
    AUTOCHECKBOX    "Create a &desktop shortcut", IDC_DESKTOP, 45, 219, 235, 11
    AUTOCHECKBOX    "&Start JustNotepad when done", IDC_RUN, 45, 232, 235, 11
    DEFPUSHBUTTON   "&Install", IDOK, 176, 246, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 232, 246, 50, 15
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Martin Petkovski"
            VALUE "FileDescription", "JustNotepad Setup"
            VALUE "ProductName", "JustNotepad"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "ProductVersion", APP_VERSION_STRING
            VALUE "OriginalFilename", "JustNotepad-Setup.exe"
            VALUE "LegalCopyright", "Copyright (C) 2025-2026 Martin Petkovski"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
